-- Перетаскивание окна (чтобы не мешало)
local dragging = false
local dragStart
f.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        f.Position = f.Position + UDim2.new(0, delta.X, 0, delta.Y)
        dragStart = input.Position
    end
end)
game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
)

-- ========== ОСТАЛЬНАЯ ЛОГИКА (НЕ ТРОГАЛ) ==========
local function verify()
    local inp = box.Text:lower():gsub("%s+", "")
    if inp == RNXkey then
        sg:Destroy()
        loadstring(game:HttpGet(RNXscript, true))()
    else
        box.Text = ""
        box.PlaceholderText = "Wrong key"
        box.PlaceholderColor3 = Color3.fromRGB(255, 90, 90)
        task.delay(1.2, function()
            box.PlaceholderText = "ключ..."
            box.PlaceholderColor3 = Color3.fromRGB(180, 180, 195)
        end)
    end
end

sub.MouseButton1Click:Connect(verify)
box.FocusLost:Connect(function(enterPressed)
    if enterPressed then verify() end
end)

get.MouseButton1Click:Connect(function()
    setclip(RNXlink)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Link copied",
        Text = "Paste in telegram → search script copy key!",
        Duration = 5
    })
end)
